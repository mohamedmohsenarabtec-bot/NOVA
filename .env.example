# Public build configuration only. Copy to config/local.json using the JSON example.
APP_NAME=NOVA
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
SUPABASE_PROJECT_REF=YOUR_PROJECT_REFERENCE
AUTH_EMAIL_RECOVERY_ENABLED=false
# NEVER put a service-role key, FCM credentials or payment secret here.
